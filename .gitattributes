# Normalise line endings so build-time parsers behave identically on every
# clone. scripts/prerender.mjs reads frontmatter out of the markdown sources,
# and a Windows checkout with core.autocrlf=true otherwise hands it CRLF while
# CI hands it LF.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

*.md text
*.txt text
